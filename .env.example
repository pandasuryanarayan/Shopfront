# ---------------------------------------------------------------------------
# Copy to .env  (or just run `npm run setup`, which does it for you)
# Never commit .env — it is gitignored.
# ---------------------------------------------------------------------------

# --- runtime ---
NODE_ENV=development
PORT=4000
ADMIN_PORT=4001
# Where the storefront sends people who open /mukhiya (set this in production)
ADMIN_PUBLIC_URL=
STORE_PUBLIC_URL=

# --- security (REQUIRED in production) ---
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
JWT_SECRET=YOUR_JWT_SECRET_HERE
JWT_TTL=7d

# --- branding (used to seed a fresh database) ---
SHOP_NAME=Shopfront
CURRENCY=INR
SUPPORT_EMAIL=help@shopfront.in

# --- pricing defaults (paise; change later in the admin Settings page) ---
TAX_PERCENT=18
FREE_DELIVERY_THRESHOLD=49900
DELIVERY_FEE=4900

# --- storage ---
DB_FILE=./data/shopfront.db
