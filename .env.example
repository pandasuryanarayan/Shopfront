# Copy to .env and adjust for your environment
NODE_ENV=development

# Storefront
PORT=4000

# Admin panel — its own port and session cookie. Set to 0 to disable.
ADMIN_PORT=4001
# Where the storefront redirects /mukhiya to (defaults to http://localhost:$ADMIN_PORT)
ADMIN_PUBLIC_URL=http://localhost:4001

JWT_SECRET=replace-with-a-long-random-string
JWT_TTL=7d
DB_FILE=./data/shopfront.db
